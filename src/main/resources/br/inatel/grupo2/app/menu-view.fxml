<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="520.0" prefWidth="720.0" spacing="16.0" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.inatel.grupo2.controller.MenuController">
    <padding>
        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0"/>
    </padding>

    <Label fx:id="tituloTela" text="GAME HUB" styleClass="screen-title"/>
    <Label text="BY grupo 2." styleClass="helper-text"/>

    <Label fx:id="textoBemVindo" styleClass="screen-subtitle"/>

    <Label text="Escolha um jogo da lista para abrir a experiencia visual." styleClass="helper-text"/>

    <ListView fx:id="listaJogos" prefHeight="220.0" prefWidth="340.0" styleClass="game-list"/>

    <HBox spacing="12.0" alignment="CENTER">
        <Button text="Jogar" onAction="#onIniciarJogo" styleClass="primary-button"/>
        <Button text="Novo Jogo" onAction="#onAdicionarJogo" styleClass="secondary-button"/>
        <Button text="Remover" onAction="#onRemoverJogo" styleClass="secondary-button"/>
    </HBox>

    <Button text="Mudar Meu Nick" onAction="#onTrocarNick" styleClass="ghost-button"/>

    <Label fx:id="statusLabel" text="Selecione um jogo e clique em Jogar." styleClass="status-label" wrapText="true"/>
</VBox>
